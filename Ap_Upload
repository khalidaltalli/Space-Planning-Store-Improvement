<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Access Points Upload — IT Provisioning</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: #0f1117; color: #e2e8f0; font-family: 'DM Sans', sans-serif; min-height: 100vh; }

    /* ── Header ── */
    .header { background: #1a1f2e; border-bottom: 0.5px solid rgba(255,255,255,0.07); padding: 0.75rem 1.5rem; display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 50; }
    .header-title { font-size: 15px; font-weight: 700; color: #f1f5f9; }
    .header-sub { font-size: 11px; color: #64748b; margin-top: 1px; }
    .missing-pill { font-size: 11px; padding: 4px 12px; border-radius: 20px; background: rgba(251,191,36,0.12); border: 0.5px solid rgba(251,191,36,0.3); color: #fbbf24; font-weight: 600; }
    .missing-pill.ok { background: rgba(74,222,128,0.1); border-color: rgba(74,222,128,0.3); color: #4ade80; }
    .user-pill { font-size: 11px; padding: 3px 10px; border-radius: 20px; background: rgba(34,211,238,0.1); border: 0.5px solid rgba(34,211,238,0.2); color: #22d3ee; }

    /* ── Login ── */
    .login-wrap { display: flex; align-items: center; justify-content: center; min-height: 80vh; }
    .login-card { background: #1a1f2e; border: 0.5px solid rgba(255,255,255,0.08); border-radius: 12px; padding: 2rem; width: 320px; }
    .login-card h2 { font-size: 18px; font-weight: 700; margin-bottom: 0.25rem; }
    .login-card p { font-size: 12px; color: #64748b; margin-bottom: 1.5rem; }
    .login-error { font-size: 11px; color: #f87171; margin-top: 8px; display: none; }

    /* ── Filters ── */
    .filters { padding: 0.75rem 1.5rem; display: flex; gap: 10px; align-items: center; flex-wrap: wrap; border-bottom: 0.5px solid rgba(255,255,255,0.05); }
    .filter-btn { font-size: 11px; padding: 4px 12px; border-radius: 20px; border: 0.5px solid rgba(255,255,255,0.1); background: transparent; color: #94a3b8; cursor: pointer; font-family: 'DM Sans', sans-serif; transition: all 0.15s; }
    .filter-btn.active { background: rgba(34,211,238,0.12); border-color: rgba(34,211,238,0.3); color: #22d3ee; }
    .filter-btn.red.active { background: rgba(248,113,113,0.12); border-color: rgba(248,113,113,0.3); color: #f87171; }
    .search-input { background: #1a1f2e; border: 0.5px solid rgba(255,255,255,0.1); color: #e2e8f0; font-size: 11px; padding: 5px 10px; border-radius: 6px; font-family: 'DM Sans', sans-serif; width: 180px; }
    .search-input:focus { outline: none; border-color: rgba(34,211,238,0.3); }

    /* ── Table ── */
    .table-wrap { padding: 1rem 1.5rem; overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; font-size: 12px; }
    thead th { padding: 8px 10px; text-align: left; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.4px; color: #64748b; border-bottom: 0.5px solid rgba(255,255,255,0.08); white-space: nowrap; }
    tbody tr { border-bottom: 0.5px solid rgba(255,255,255,0.04); transition: background 0.1s; }
    tbody tr:hover { background: rgba(255,255,255,0.02); }
    tbody td { padding: 8px 10px; vertical-align: middle; }

    /* ── AP Cell ── */
    .ap-cell { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    .ap-status { font-size: 10px; padding: 2px 7px; border-radius: 10px; font-weight: 600; white-space: nowrap; }
    .ap-done    { background: rgba(74,222,128,0.12); color: #4ade80; }
    .ap-pending { background: rgba(251,191,36,0.12); color: #fbbf24; }
    .ap-missing { background: rgba(248,113,113,0.12); color: #f87171; }
    .upload-btn { font-size: 10px; padding: 2px 8px; border-radius: 5px; background: rgba(167,139,250,0.1); border: 0.5px solid rgba(167,139,250,0.25); color: #a78bfa; cursor: pointer; font-family: 'DM Sans', sans-serif; white-space: nowrap; }
    .upload-btn:hover { background: rgba(167,139,250,0.18); }
    .upload-btn:disabled { opacity: 0.4; cursor: not-allowed; }
    .view-link { font-size: 10px; color: #22d3ee; text-decoration: none; }
    .view-link:hover { text-decoration: underline; }

    /* ── Toast ── */
    #toast { position: fixed; bottom: 1.5rem; right: 1.5rem; background: #1a1f2e; border: 0.5px solid rgba(74,222,128,0.3); color: #4ade80; font-size: 12px; padding: 8px 16px; border-radius: 8px; opacity: 0; transition: opacity 0.3s; pointer-events: none; z-index: 300; }

    /* ── Forms ── */
    .form-input { width: 100%; background: #0f1117; border: 0.5px solid rgba(255,255,255,0.12); color: #e2e8f0; font-size: 12px; padding: 8px 10px; border-radius: 6px; font-family: 'DM Sans', sans-serif; }
    .form-input:focus { outline: none; border-color: rgba(34,211,238,0.4); }
    .btn { font-size: 12px; padding: 7px 16px; border-radius: 7px; border: 0.5px solid rgba(255,255,255,0.1); background: rgba(255,255,255,0.04); color: #e2e8f0; cursor: pointer; font-family: 'DM Sans', sans-serif; font-weight: 600; transition: all 0.15s; }
    .btn-primary { background: rgba(167,139,250,0.1); border-color: rgba(167,139,250,0.3); color: #a78bfa; }

    /* ── Activity Log ── */
    .log-wrap { padding: 0 1.5rem 2rem; }
    .log-title { font-size: 13px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.75rem; padding-top: 1rem; border-top: 0.5px solid rgba(255,255,255,0.06); }
    .log-date-group { margin-bottom: 8px; border: 0.5px solid rgba(255,255,255,0.06); border-radius: 8px; overflow: hidden; }
    .log-date-header { display: flex; align-items: center; justify-content: space-between; padding: 7px 12px; background: rgba(255,255,255,0.03); cursor: pointer; font-size: 11px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.4px; user-select: none; }
    .log-date-header:hover { background: rgba(255,255,255,0.05); }
    .log-date-body { padding: 4px 0; }
    .log-date-count { font-size: 10px; background: rgba(167,139,250,0.15); color: #a78bfa; padding: 1px 7px; border-radius: 8px; font-weight: 600; }
    .log-chevron { font-size: 10px; color: #475569; transition: transform 0.2s; }
    .log-entry { display: flex; gap: 10px; padding: 7px 12px; border-bottom: 0.5px solid rgba(255,255,255,0.04); font-size: 11px; }
    .log-entry:last-child { border-bottom: none; }
    .log-dot { width: 7px; height: 7px; border-radius: 50%; background: #a78bfa; margin-top: 3px; flex-shrink: 0; }

    input[type=file] { display: none; }
  </style>
</head>
<body>

<!-- ══ LOGIN ══ -->
<div id="login-screen">
  <div class="login-wrap">
    <div class="login-card">
      <h2>📡 Access Points Upload</h2>
      <p>Request submission & IT provisioning</p>
      <div style="margin-bottom:10px;">
        <label style="font-size:11px;color:#94a3b8;display:block;margin-bottom:4px;">Name</label>
        <select id="login-user" class="form-input" onchange="togglePinField()">
          <option value="">Loading...</option>
        </select>
      </div>
      <div id="pin-wrap" style="margin-bottom:14px;">
        <label style="font-size:11px;color:#94a3b8;display:block;margin-bottom:4px;">PIN</label>
        <input id="login-pin" type="password" class="form-input" placeholder="Enter PIN" onkeydown="if(event.key==='Enter')doLogin()" />
      </div>
      <button class="btn btn-primary" style="width:100%;" onclick="doLogin()">Sign In</button>
      <div id="login-error" class="login-error">Incorrect PIN. Please try again.</div>
    </div>
  </div>
</div>

<!-- ══ MAIN APP ══ -->
<div id="app" style="display:none;">

  <!-- Header -->
  <div class="header">
    <div style="display:flex;align-items:center;gap:12px;">
      <a href="index.html" style="display:flex;align-items:center;text-decoration:none;">
        <img src="logo.png" style="height:60px;object-fit:contain;" alt="Logo" />
      </a>
      <div>
        <div class="header-title">Access Points — Upload Portal</div>
        <div class="header-sub">Request submission & IT provisioning</div>
      </div>
    </div>
    <div style="display:flex;align-items:center;gap:10px;">
      <span id="missing-pill" class="missing-pill">Loading...</span>
      <span id="current-user-pill" class="user-pill"></span>
      <button class="btn" style="font-size:11px;padding:4px 10px;" onclick="loadData()">↻ Refresh</button>
      <button class="btn" style="font-size:11px;padding:4px 10px;" onclick="signOut()">Sign Out</button>
    </div>
  </div>

  <!-- Filters -->
  <div class="filters">
    <button class="filter-btn active" onclick="setFilter('all',this)">All</button>
    <button class="filter-btn red" onclick="setFilter('missing',this)">Missing Only</button>
    <button class="filter-btn" onclick="setFilter('pending',this)">Pending IT</button>
    <button class="filter-btn" onclick="setFilter('done',this)">Completed</button>
    <input class="search-input" id="branch-search" placeholder="Search branch..." oninput="applyFilter()" />
    <span id="count-label" style="font-size:11px;color:#475569;margin-left:auto;"></span>
  </div>

  <!-- Table -->
  <div class="table-wrap">
    <div id="loading" style="text-align:center;padding:3rem;color:#475569;font-size:13px;">Loading branches...</div>
    <table id="ap-table" style="display:none;">
      <thead>
        <tr>
          <th style="min-width:120px;">Branch</th>
          <th style="min-width:80px;">Branch Status</th>
          <th>Access Points Request</th>
        </tr>
      </thead>
      <tbody id="ap-tbody"></tbody>
    </table>
  </div>

  <!-- Activity Log -->
  <div class="log-wrap">
    <div class="log-title">📋 Upload Activity Log</div>
    <div id="activity-log"><p style="font-size:11px;color:#475569;">Loading...</p></div>
  </div>

</div>

<!-- Toast -->
<div id="toast"></div>

<script>
  /* ═════════════════════════════════════════════════════════════
     BACKEND NOTE: this reuses the same Apps Script endpoint as the
     D.N. page, but expects three new server-side actions that mirror
     writeDNLink / writeSignedDNLink / removeDNLink:
       - 'writeAPRequestLink'  (requester submits the PDF/link)
       - 'writeAPConfirmLink'  (IT submits their confirmation link)
       - 'removeAPLink'
     and a checklist read filtered to Asset === 'Access Points',
     using two new columns instead of D.N. Signed / D.N. Not Signed:
       - 'AP Request Link'   (submitted by requester)
       - 'AP Confirmed Link' (submitted by IT once provisioned)
     Activity log reads/writes from a new sheet: 'AP Upload Log'.
     Swap APPS_URL below if this lives on a different Apps Script
     deployment than the D.N. page.
     ═════════════════════════════════════════════════════════════ */
  const APPS_URL = 'https://script.google.com/macros/s/AKfycbxY3lrOH9WfROO51kJfik2McVOE1MsWtFzsR-G6b8wqqSdTUOTiG-1ONj946YAXSwAzeQ/exec';

  const PAGE_KEY_AP = 'AP Upload';
  let usersDataAP  = [];
  let currentUser  = '';
  let isViewer     = false;

  const FALLBACK_USERS_AP = [
    {Name:'Kamal',       PIN:'1234', 'AP Upload':'Editor'},
    {Name:'Ahmed Khalil',PIN:'1234', 'AP Upload':'Editor'},
    {Name:'Azhar',       PIN:'0000', 'AP Upload':'Editor'},
    {Name:'Khalid',      PIN:'6969', 'AP Upload':'Editor'},
    {Name:'IT Team',     PIN:'1111', 'AP Upload':'Editor'},
    {Name:'Viewer',      PIN:'',     'AP Upload':'Viewer'},
  ];

  function populateAPDropdown() {
    const sel = document.getElementById('login-user');
    sel.innerHTML = '<option value="">Select your name</option>' +
      usersDataAP.map(u=>`<option value="${u['Name']}">${u['Name']}</option>`).join('');
    togglePinField();
  }

  async function loadUsersAP() {
    usersDataAP = FALLBACK_USERS_AP;
    populateAPDropdown();
    try {
      const r = await Promise.race([
        fetch(`${APPS_URL}?sheet=Users`).then(res=>res.json()),
        new Promise((_,rej)=>setTimeout(()=>rej(new Error('timeout')),6000))
      ]);
      const fromSheet=(r.rows||[]).filter(u=>u['Name']);
      if(fromSheet.length){ usersDataAP=fromSheet; populateAPDropdown(); }
    } catch(e){ /* keep fallback */ }
  }

  function togglePinField() {
    const user = document.getElementById('login-user').value;
    const u    = usersDataAP.find(x=>x['Name']===user);
    document.getElementById('pin-wrap').style.display = (u && !u['PIN']) ? 'none' : 'block';
  }

  function showLoginError(msg) {
    const el = document.getElementById('login-error');
    el.textContent = msg;
    el.style.display = 'block';
  }

  function doLogin() {
    const name = document.getElementById('login-user').value;
    const pin  = document.getElementById('login-pin').value;
    if(!name) return;
    const user = usersDataAP.find(u=>u['Name']===name);
    if(!user){ showLoginError('User not found.'); return; }
    if(user['PIN'] && user['PIN']!==pin){ showLoginError('Incorrect PIN. Please try again.'); document.getElementById('login-pin').value=''; return; }
    currentUser = name;
    isViewer    = (user[PAGE_KEY_AP]||'').toLowerCase()==='viewer' || !user['PIN'];
    document.getElementById('login-screen').style.display='none';
    document.getElementById('app').style.display='block';
    document.getElementById('current-user-pill').textContent=isViewer?'👁 View Only':name;
    loadData();
  }

  function signOut() {
    currentUser = '';
    document.getElementById('app').style.display = 'none';
    document.getElementById('login-screen').style.display = 'block';
    document.getElementById('login-pin').value = '';
    document.getElementById('login-error').style.display = 'none';
  }

  /* Single asset group — this page only tracks Access Points. */
  const AP_GROUP = { key:'ap', name:'Access Points', assets:['Access Points'] };

  let allBranches   = [];
  let checklistData = [];
  let currentFilter = 'all';
  let activityLog   = [];

  /* ══ LOAD DATA ══ */
  async function loadData() {
    document.getElementById('loading').style.display = 'block';
    document.getElementById('ap-table').style.display = 'none';
    try {
      const [bcRes, clRes, logRes] = await Promise.all([
        fetch(`${APPS_URL}?sheet=Branch%20Codes`).then(r=>r.json()),
        fetch(`${APPS_URL}?sheet=Receiving%20Checklist`).then(r=>r.json()),
        fetch(`${APPS_URL}?sheet=AP%20Upload%20Log`).then(r=>r.json()).catch(()=>({rows:[]}))
      ]);

      allBranches = (bcRes.rows||[])
        .map(r=>({ code:r['Branch Code'], status:r['Branch Status'] }))
        .sort((a,b)=>a.code.localeCompare(b.code));

      checklistData = clRes.rows||[];
      activityLog   = (logRes.rows||[]).slice(-50).reverse();

      renderTable();
      renderLog();
      updateMissingPill();
    } catch(e) {
      document.getElementById('loading').textContent = 'Failed to load: ' + e.message;
    }
  }

  /* ══ BUILD TABLE ══ */
  function renderTable() {
    document.getElementById('loading').style.display = 'none';
    document.getElementById('ap-table').style.display = 'table';
    applyFilter();
  }

  function applyFilter() {
    const search = document.getElementById('branch-search').value.toLowerCase();
    const tbody  = document.getElementById('ap-tbody');
    tbody.innerHTML = '';
    let shown = 0;

    allBranches.forEach(branch => {
      if (search && !branch.code.toLowerCase().includes(search)) return;
      const assets = checklistData.filter(r=>(r['Branch Code']||'').trim()===branch.code);
      const g = getAPStatus(assets);

      if (currentFilter === 'missing' && g.status!=='missing') return;
      if (currentFilter === 'pending' && g.status!=='pending') return;
      if (currentFilter === 'done'    && g.status!=='done')    return;

      shown++;
      const statusColor = { Receiving:'#22d3ee', Live:'#4ade80', Pending:'#fbbf24', Completed:'#94a3b8' }[branch.status]||'#94a3b8';
      const isEXP = branch.code.endsWith('EXP');
      const tr = document.createElement('tr');
      tr.dataset.branch = branch.code;
      const canRemove = !isViewer && (currentUser==='Khalid'||currentUser==='Azhar');

      let apCell = `<div class="ap-cell">`;
      if (g.status === 'done') {
        apCell += `<span class="ap-status ap-done">✓ Completed</span>`;
        if (g.confirmLink) apCell += `<a href="${g.confirmLink}" target="_blank" class="view-link">View IT confirmation</a>`;
        if (g.requestLink) apCell += `<a href="${g.requestLink}" target="_blank" class="view-link">View request</a>`;
        if (canRemove) apCell += `<button class="upload-btn" style="background:rgba(248,113,113,0.1);border-color:rgba(248,113,113,0.3);color:#f87171;" data-branch="${branch.code}" data-type="confirm" onclick="removeAPLinkBtn(this)">✕</button>`;
      } else if (g.status === 'pending') {
        apCell += `<span class="ap-status ap-pending">📎 Pending IT</span>`;
        if (g.requestLink) apCell += `<a href="${g.requestLink}" target="_blank" class="view-link">View request</a>`;
        if (!isViewer) apCell += `<button class="upload-btn" data-branch="${branch.code}" onclick="triggerUploadBtn(this,'confirm')">＋ IT Confirm</button>`;
        if (canRemove) apCell += `<button class="upload-btn" style="background:rgba(248,113,113,0.1);border-color:rgba(248,113,113,0.3);color:#f87171;" data-branch="${branch.code}" data-type="request" onclick="removeAPLinkBtn(this)">✕</button>`;
      } else {
        apCell += `<span class="ap-status ap-missing">Missing</span>`;
        if (!isViewer) apCell += `<button class="upload-btn" data-branch="${branch.code}" onclick="triggerUploadBtn(this,'request')">＋ Submit Request</button>`;
      }
      apCell += `</div>`;

      tr.innerHTML = `
        <td style="font-weight:700;color:#f1f5f9;">${branch.code}${isEXP?' <span style="font-size:8px;font-weight:700;padding:1px 5px;border-radius:5px;background:rgba(251,191,36,0.2);color:#fbbf24;">EXP</span>':''}</td>
        <td><span style="font-size:10px;font-weight:600;color:${statusColor};">${branch.status}</span></td>
        <td>${apCell}</td>`;
      tbody.appendChild(tr);
    });

    document.getElementById('count-label').textContent = `${shown} branches`;
  }

  function getAPStatus(assets) {
    const rows = assets.filter(r=>AP_GROUP.assets.includes((r['Asset']||'').trim()));
    const confirmed = rows.find(r=>r['AP Confirmed Link']&&r['AP Confirmed Link'].startsWith('http'));
    const requested = rows.find(r=>r['AP Request Link']&&r['AP Request Link'].startsWith('http'));
    if (confirmed) return { status:'done',    confirmLink: confirmed['AP Confirmed Link'], requestLink: requested ? requested['AP Request Link'] : '' };
    if (requested) return { status:'pending', requestLink: requested['AP Request Link'] };
    return { status:'missing' };
  }

  function updateMissingPill() {
    let pending = 0;
    allBranches.forEach(b => {
      const assets = checklistData.filter(r=>(r['Branch Code']||'').trim()===b.code);
      const g = getAPStatus(assets);
      if (g.status !== 'done') pending++;
    });
    const pill = document.getElementById('missing-pill');
    if (pending === 0) {
      pill.textContent = '✓ All Access Points provisioned';
      pill.className = 'missing-pill ok';
    } else {
      pill.textContent = `📡 ${pending} branches awaiting IT`;
      pill.className = 'missing-pill';
    }
  }

  /* ══ FILTER ══ */
  function setFilter(f, btn) {
    currentFilter = f;
    document.querySelectorAll('.filter-btn').forEach(b=>b.classList.remove('active'));
    btn.classList.add('active');
    applyFilter();
  }

  /* ══ LINK MODAL ══ */
  let _apModalBranch = null;
  let _apModalType   = 'request'; /* 'request' or 'confirm' */

  function removeAPLinkBtn(btn) {
    const branch = btn.getAttribute('data-branch');
    const type   = btn.getAttribute('data-type');
    if(!confirm(`Remove ${type==='confirm'?'IT confirmation':'request'} link for ${branch} — Access Points?`)) return;
    removeAPLink(branch, type);
  }

  async function removeAPLink(branch, type) {
    const timestamp = new Date().toLocaleString('en-GB');
    await fetch(APPS_URL, {
      method:'POST', mode:'no-cors',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ action:'removeAPLink', branch, assets:AP_GROUP.assets, type, user:currentUser, timestamp })
    });
    checklistData.forEach(r=>{
      if((r['Branch Code']||'').trim()===branch && AP_GROUP.assets.includes((r['Asset']||'').trim())){
        if(type==='confirm') r['AP Confirmed Link'] = '';
        else                 r['AP Request Link']   = '';
      }
    });
    activityLog.unshift({
      Timestamp: timestamp, User: currentUser,
      'Branch Code': branch, 'Group': AP_GROUP.name,
      'File Name': type==='confirm' ? '🗑 IT Confirmation Removed' : '🗑 Request Removed',
      'File URL': '', 'Type': type
    });
    showToast('✓ Link removed');
    applyFilter();
    updateMissingPill();
    renderLog();
  }

  function triggerUploadBtn(btn, type) {
    triggerUpload(btn.getAttribute('data-branch'), type);
  }

  function triggerUpload(branch, type) {
    _apModalBranch = branch;
    _apModalType   = type;
    document.getElementById('ap-modal-title').textContent    = type==='confirm' ? `IT Confirmation — ${branch}` : `Submit Request — ${branch}`;
    document.getElementById('ap-modal-subtitle').textContent = type==='confirm'
      ? 'Paste the link once the access points have been provisioned.'
      : 'Paste the link to the PDF listing the access points to add.';
    document.getElementById('ap-link-input').value = '';
    document.getElementById('ap-link-modal').style.display = 'flex';
    setTimeout(()=>document.getElementById('ap-link-input').focus(), 50);
  }

  function closeAPModal() {
    document.getElementById('ap-link-modal').style.display = 'none';
    _apModalBranch = null;
  }

  function saveAPFromModal() {
    const link = document.getElementById('ap-link-input').value.trim();
    if (!link) { showToast('✗ Please paste a link', true); return; }
    if (!link.startsWith('http')) { showToast('✗ Invalid link — must start with http', true); return; }
    const branch = _apModalBranch;
    const type   = _apModalType;
    closeAPModal();
    saveAPLink(branch, link, type);
  }

  async function saveAPLink(branch, fileUrl, type) {
    const timestamp = new Date().toLocaleString('en-GB');
    const action = type === 'confirm' ? 'writeAPConfirmLink' : 'writeAPRequestLink';
    await fetch(APPS_URL, {
      method: 'POST',
      mode: 'no-cors',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        action, branch, assets: AP_GROUP.assets, groupName: AP_GROUP.name,
        fileName: 'Manual link entry', fileUrl, user: currentUser, timestamp
      })
    });
    checklistData.forEach(r => {
      if ((r['Branch Code']||'').trim()===branch && AP_GROUP.assets.includes((r['Asset']||'').trim())) {
        if (type === 'confirm') r['AP Confirmed Link'] = fileUrl;
        else r['AP Request Link'] = fileUrl;
      }
    });
    activityLog.unshift({
      Timestamp: timestamp, User: currentUser,
      'Branch Code': branch, 'Group': AP_GROUP.name,
      'File Name': type === 'confirm' ? '✓ IT Confirmation' : '📎 Request Submitted',
      'File URL': fileUrl, 'Type': type
    });
    showToast(`✓ ${type === 'confirm' ? 'IT confirmation' : 'Request'} link saved!`);
    applyFilter();
    updateMissingPill();
    renderLog();
  }

  /* ══ ACTIVITY LOG ══ */
  function renderLog() {
    const container = document.getElementById('activity-log');
    if (!activityLog.length) {
      container.innerHTML = '<p style="font-size:11px;color:#475569;">No uploads yet.</p>';
      return;
    }

    const groups = {};
    activityLog.slice(0, 60).forEach(e => {
      const ts = e['Timestamp'] || '';
      let date = '';
      const gbMatch = ts.match(/^(\d{1,2}\/\d{1,2}\/\d{4})/);
      if (gbMatch) {
        date = gbMatch[1];
      } else {
        const d = new Date(ts);
        date = !isNaN(d) ? d.toLocaleDateString('en-GB') : (ts.split(',')[0].trim() || 'Unknown');
      }
      if (!date) date = 'Unknown';
      if (!groups[date]) groups[date] = [];
      groups[date].push(e);
    });

    const today     = new Date().toLocaleDateString('en-GB');
    const yesterday = new Date(Date.now()-86400000).toLocaleDateString('en-GB');

    container.innerHTML = Object.entries(groups).map(([date, entries], gi) => {
      const label = date === today ? `Today — ${date}` : date === yesterday ? `Yesterday — ${date}` : date;
      const isOpen = gi === 0;
      const groupId = 'log-group-' + gi;

      const entriesHtml = entries.map(e => {
        const isConfirm = e['Type']==='confirm' || (e['File Name']||'').includes('Confirmation');
        const dotColor  = isConfirm ? '#4ade80' : '#fbbf24';
        const typeLabel = isConfirm
          ? '<span style="font-size:9px;padding:1px 6px;border-radius:5px;background:rgba(74,222,128,0.12);color:#4ade80;font-weight:700;">✓ IT Confirmed</span>'
          : '<span style="font-size:9px;padding:1px 6px;border-radius:5px;background:rgba(251,191,36,0.12);color:#fbbf24;font-weight:700;">📎 Request</span>';
        const hasLink = e['File URL'] && e['File URL'].startsWith('http');
        return `<div class="log-entry">
          <div class="log-dot" style="background:${dotColor};margin-top:3px;"></div>
          <div style="flex:1;min-width:0;">
            <div style="display:flex;gap:8px;align-items:baseline;flex-wrap:wrap;">
              <span style="font-weight:600;color:#e2e8f0;">${e['Branch Code']||''}</span>
              <span style="color:#a78bfa;">${e['Group']||'Access Points'}</span>
              ${typeLabel}
              <span style="color:#94a3b8;font-size:10px;">by ${e['User']||''}</span>
              <span style="color:#475569;font-size:10px;margin-left:auto;">${(()=>{ const ts=e['Timestamp']||''; const m=ts.match(/\d{1,2}:\d{2}/); return m?m[0]:''; })()}</span>
            </div>
            <div style="font-size:10px;color:#475569;margin-top:2px;display:flex;align-items:center;gap:8px;">
              <span>${e['File Name']||''}</span>
              ${hasLink ? `<a href="${e['File URL']}" target="_blank" style="font-size:10px;padding:1px 8px;border-radius:4px;background:rgba(34,211,238,0.08);border:0.5px solid rgba(34,211,238,0.2);color:#22d3ee;text-decoration:none;flex-shrink:0;">👁 View</a>` : ''}
            </div>
          </div>
        </div>`;
      }).join('');

      return `<div class="log-date-group">
        <div class="log-date-header" onclick="toggleLogGroup('${groupId}',this)">
          <span>${label}</span>
          <div style="display:flex;align-items:center;gap:8px;">
            <span class="log-date-count">${entries.length} update${entries.length!==1?'s':''}</span>
            <span class="log-chevron" style="transform:${isOpen?'rotate(0deg)':'rotate(-90deg)'}">▼</span>
          </div>
        </div>
        <div id="${groupId}" class="log-date-body" style="display:${isOpen?'block':'none'};">
          ${entriesHtml}
        </div>
      </div>`;
    }).join('');
  }

  function toggleLogGroup(id, header) {
    const body    = document.getElementById(id);
    const chevron = header.querySelector('.log-chevron');
    const isOpen  = body.style.display !== 'none';
    body.style.display    = isOpen ? 'none' : 'block';
    chevron.style.transform = isOpen ? 'rotate(-90deg)' : 'rotate(0deg)';
  }

  /* ══ BOOT ══ */
  window.addEventListener('DOMContentLoaded', ()=>{
    loadUsersAP();
    document.getElementById('ap-link-input').addEventListener('keydown', e=>{ if(e.key==='Enter') saveAPFromModal(); });
  });
  let toastTimer;
  function showToast(msg, error=false) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.style.borderColor = error ? 'rgba(248,113,113,0.3)' : 'rgba(74,222,128,0.3)';
    t.style.color = error ? '#f87171' : '#4ade80';
    t.style.opacity = '1';
    clearTimeout(toastTimer);
    toastTimer = setTimeout(()=>t.style.opacity='0', 3500);
  }
</script>

<!-- ══ AP LINK MODAL ══ -->
<div id="ap-link-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:200;align-items:center;justify-content:center;">
  <div style="background:#1a1f2e;border:0.5px solid rgba(255,255,255,0.12);border-radius:12px;padding:1.5rem;width:420px;">
    <h3 style="font-size:15px;font-weight:700;color:#f1f5f9;margin-bottom:4px;" id="ap-modal-title">Submit Request</h3>
    <p style="font-size:11px;color:#64748b;margin-bottom:1rem;" id="ap-modal-subtitle"></p>

    <label style="font-size:11px;color:#94a3b8;display:block;margin-bottom:4px;">Paste Drive Link</label>
    <input id="ap-link-input" class="form-input" placeholder="https://drive.google.com/..." style="margin-bottom:14px;" />

    <div style="display:flex;gap:8px;justify-content:flex-end;">
      <button class="btn" onclick="closeAPModal()" style="background:rgba(255,255,255,0.05);border-color:rgba(255,255,255,0.1);color:#94a3b8;">Cancel</button>
      <button class="btn" onclick="saveAPFromModal()" style="background:rgba(167,139,250,0.1);border-color:rgba(167,139,250,0.3);color:#a78bfa;">Save Link</button>
    </div>
  </div>
</div>

</body>
